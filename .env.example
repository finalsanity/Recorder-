# Development uses isolated providers by default. Set AUTH_MODE=entra and GRAPH_MODE=live in production.
AUTH_MODE=mock
GRAPH_MODE=mock
AUTH_SECRET=replace-with-a-long-random-value
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:4173/api/auth/callback
DATABASE_URL=mysql://trace_user:trace_password@127.0.0.1:3306/trace
